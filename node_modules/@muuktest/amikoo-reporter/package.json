{
  "name": "@muuktest/amikoo-reporter",
  "version": "1.2.2",
  "description": "Playwright reporter for Amikoo - automatically installs and configures test reporting to Amikoo AI",
  "main": "dist/controlHubReporter.js",
  "types": "dist/controlHubReporter.d.ts",
  "exports": {
    ".": {
      "types": "./dist/controlHubReporter.d.ts",
      "default": "./dist/controlHubReporter.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "prepublishOnly": "npm run build",
    "postinstall": "node install.js"
  },
  "files": [
    "dist/**/*",
    "install.js",
    "playwright.config.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muuklabs/controlhub-reporter.git"
  },
  "keywords": [
    "playwright",
    "reporter",
    "controlhub",
    "testing",
    "test-automation",
    "playwright-reporter"
  ],
  "author": "MuukLabs",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/muuklabs/controlhub-reporter/issues"
  },
  "homepage": "https://github.com/muuklabs/controlhub-reporter#readme",
  "peerDependencies": {
    "@playwright/test": "^1.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^25.3.5",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^17.3.1"
  }
}
